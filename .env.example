# ========================================================
# Guidora Unified Orchestration - Environment Template
# Copy this file to .env and configure secrets before launching.
# .env is local-only and excluded from Git.
# ========================================================

# --------------------------------------------------------
# 1. NETWORK & PORT ROUTING
# --------------------------------------------------------
# Frontend exposed HTTP port (e.g., http://localhost)
FRONTEND_PORT=80
# Backend direct WebAPI port (e.g., http://localhost:8080)
BACKEND_PORT=8080
# Infrastructure bind address (127.0.0.1 for local security)
INFRA_BIND_ADDRESS=127.0.0.1
# Client origin for CORS (Nginx proxy origin)
WEB_CLIENT_ORIGIN=http://localhost
FORWARDED_HEADERS_KNOWN_PROXIES_0=

# --------------------------------------------------------
# 2. RUNTIME & ENVIRONMENT
# --------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
DATABASE_APPLY_MIGRATIONS_ON_STARTUP=true
AUTHORIZATION_SYNC_OPERATION_CLAIMS_ON_STARTUP=true
LOG_LEVEL_DEFAULT=Information
LOG_LEVEL_ASPNETCORE=Warning
ALLOWED_HOSTS=*

# --------------------------------------------------------
# 3. DATABASE (PostgreSQL 18)
# --------------------------------------------------------
POSTGRES_DB=guidora
POSTGRES_USER=guidora
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# --------------------------------------------------------
# 4. DISTRIBUTED CACHE (Redis 8 volatile-lfu)
# --------------------------------------------------------
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_MAXMEMORY=256mb
REDIS_CONTAINER_MEMORY_LIMIT=320m

# --------------------------------------------------------
# 5. ASYNC MESSAGE BROKER (Optional: RabbitMQ 4)
# --------------------------------------------------------
RABBITMQ_USER=guidora
RABBITMQ_PASSWORD=
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --------------------------------------------------------
# 6. SECURITY & JWT (Zero Template Keys)
# --------------------------------------------------------
TOKEN_OPTIONS__SECURITYKEY=
TOKEN_OPTIONS__ISSUER=Guidora
TOKEN_OPTIONS__AUDIENCE=Guidora
TOKEN_OPTIONS__ACCESS_TOKEN_EXPIRATION_MINUTES=15
TOKEN_OPTIONS__REFRESH_TOKEN_EXPIRATION_DAYS=30
TOKEN_OPTIONS__REMEMBER_ME_EXPIRATION_DAYS=90
TOKEN_OPTIONS__SESSION_ABSOLUTE_EXPIRATION_DAYS=180
TOKEN_OPTIONS__CLOCK_SKEW_SECONDS=30

COMMUNITY_VERIFICATION_SIGNAL_HASH_KEY=

# --------------------------------------------------------
# 7. BOOTSTRAP ADMINISTRATOR ACCOUNT
# --------------------------------------------------------
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --------------------------------------------------------
# 8. EMAIL VERIFICATION (SMTP)
# --------------------------------------------------------
EMAIL_VERIFICATION_ENABLED=false
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_FROM=
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=

# --------------------------------------------------------
# 9. REQUEST RATE LIMITS
# --------------------------------------------------------
RATE_LIMIT_LOGIN_PERMIT_LIMIT=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER_PERMIT_LIMIT=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_REFRESH_PERMIT_LIMIT=30
RATE_LIMIT_REFRESH_WINDOW_SECONDS=60
RATE_LIMIT_EMAIL_REQUEST_PERMIT_LIMIT=3
RATE_LIMIT_EMAIL_REQUEST_WINDOW_SECONDS=3600
RATE_LIMIT_EMAIL_CONFIRM_PERMIT_LIMIT=10
RATE_LIMIT_EMAIL_CONFIRM_WINDOW_SECONDS=600
RATE_LIMIT_EMAIL_IP_PERMIT_LIMIT=120
RATE_LIMIT_EMAIL_IP_WINDOW_SECONDS=3600
RATE_LIMIT_PRODUCT_CREATE_PERMIT_LIMIT=3
RATE_LIMIT_PRODUCT_CREATE_WINDOW_SECONDS=3600
RATE_LIMIT_PRODUCT_UPDATE_PERMIT_LIMIT=10
RATE_LIMIT_PRODUCT_UPDATE_WINDOW_SECONDS=3600
RATE_LIMIT_COMMENT_CREATE_PERMIT_LIMIT=10
RATE_LIMIT_COMMENT_CREATE_WINDOW_SECONDS=600
RATE_LIMIT_PRODUCT_REPORT_PERMIT_LIMIT=5
RATE_LIMIT_PRODUCT_REPORT_WINDOW_SECONDS=3600
RATE_LIMIT_FAVORITE_MUTATION_PERMIT_LIMIT=60
RATE_LIMIT_FAVORITE_MUTATION_WINDOW_SECONDS=600
RATE_LIMIT_COMMUNITY_VOTE_PERMIT_LIMIT=30
RATE_LIMIT_COMMUNITY_VOTE_WINDOW_SECONDS=3600
RATE_LIMIT_PRODUCT_CONTENT_MUTATION_PERMIT_LIMIT=6
RATE_LIMIT_PRODUCT_CONTENT_MUTATION_WINDOW_SECONDS=3600
RATE_LIMIT_PRODUCT_METADATA_MUTATION_PERMIT_LIMIT=30
RATE_LIMIT_PRODUCT_METADATA_MUTATION_WINDOW_SECONDS=3600
