# ========================================================
# Guidora Unified Orchestration - Environment Template
# Copy this file to .env and configure secrets before launching.
# .env is local-only and excluded from Git.
# ========================================================

# Host Ports
FRONTEND_PORT=80
BACKEND_PORT=8080

# PostgreSQL (Host: postgres, Port: 5432)
POSTGRES_DB=guidora
POSTGRES_USER=guidora
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
INFRA_BIND_ADDRESS=127.0.0.1
DATABASE_APPLY_MIGRATIONS_ON_STARTUP=true

# Redis Cache (Host: redis, Port: 6379)
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_MAXMEMORY=256mb
REDIS_CONTAINER_MEMORY_LIMIT=320m

# RabbitMQ (Optional: docker compose --profile messaging up)
RABBITMQ_USER=guidora
RABBITMQ_PASSWORD=
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# JWT Security (Must be a cryptographically strong secret >= 32 chars)
TOKEN_OPTIONS__SECURITYKEY=
TOKEN_OPTIONS__ISSUER=Guidora
TOKEN_OPTIONS__AUDIENCE=Guidora
TOKEN_OPTIONS__ACCESS_TOKEN_EXPIRATION_MINUTES=15
TOKEN_OPTIONS__REFRESH_TOKEN_EXPIRATION_DAYS=30
TOKEN_OPTIONS__REMEMBER_ME_EXPIRATION_DAYS=90
TOKEN_OPTIONS__SESSION_ABSOLUTE_EXPIRATION_DAYS=180
TOKEN_OPTIONS__CLOCK_SKEW_SECONDS=30

# Community Verification Signal Key (Must be independent random secret)
COMMUNITY_VERIFICATION_SIGNAL_HASH_KEY=

# Initial Bootstrap Administrator (Set to true to provision first Admin)
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# SMTP Email Verification
EMAIL_VERIFICATION_ENABLED=false
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_FROM=
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=

# CORS & Reverse Proxy
WEB_CLIENT_ORIGIN=http://localhost
FORWARDED_HEADERS_KNOWN_PROXIES_0=

# Backend startup and logging
ASPNETCORE_ENVIRONMENT=Production
AUTHORIZATION_SYNC_OPERATION_CLAIMS_ON_STARTUP=true
LOG_LEVEL_DEFAULT=Information
LOG_LEVEL_ASPNETCORE=Warning
ALLOWED_HOSTS=localhost;127.0.0.1;backend
